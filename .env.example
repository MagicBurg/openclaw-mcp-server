# OpenClaw MCP Server Configuration

# Single instance (simplest setup)
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=
OPENCLAW_TIMEOUT=120s

# Multi-instance (overrides single-instance vars)
# OPENCLAW_INSTANCES='[{"name":"worker-1","url":"http://10.0.0.1:18789","token":"sk-1","default":true},{"name":"worker-2","url":"http://10.0.0.2:18789","token":"sk-2"}]'

# MCP server
MCP_TRANSPORT=stdio
MCP_PORT=21789
MCP_HOST=0.0.0.0
MCP_AUTH_TOKEN=
